# Copy to .env and fill in. .env is git-ignored; never commit real keys.

APP_ENV=development
HTTP_PORT=8080

# Matches the Postgres service in docker-compose.yml.
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard?sslmode=disable

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h

# Per-call timeout for external widget APIs.
EXTERNAL_TIMEOUT=5s

# External API keys. Frankfurter (currency) needs none.
OPENWEATHERMAP_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
